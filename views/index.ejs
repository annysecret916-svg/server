<!DOCTYPE html>
<html lang="th">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Whitelist Management System</title>
    <script src="https://cdn.tailwindcss.com"></script>
    <link href="https://fonts.googleapis.com/css2?family=Tahoma:wght@400;700&display=swap" rel="stylesheet">
    <style> body { font-family: 'Tahoma', sans-serif; } </style>
</head>
<body class="bg-slate-900 text-slate-100 min-h-screen p-6">

    <div class="max-w-5xl mx-auto">
        <!-- Header -->
        <div class="flex justify-between items-center mb-8 border-b border-slate-700 pb-4">
            <div>
                <h1 class="text-2xl font-bold text-red-500">Whitelist Management</h1>
                <p class="text-slate-400 text-sm">ระบบจัดการข้อมูล Whitelist สำหรับ Private Server Launcher</p>
            </div>
            <div class="bg-slate-800 px-4 py-2 rounded-lg border border-slate-700 text-sm">
                จำนวนทั้งหมด: <span class="font-bold text-emerald-400"><%= whitelist.length %></span> รายการ
            </div>
        </div>

        <!-- Add Form Card -->
        <div class="bg-slate-800 p-6 rounded-xl border border-slate-700 mb-8 shadow-xl">
            <h2 class="text-lg font-bold mb-4 text-slate-200">➕ เพิ่ม Whitelist ใหม่</h2>
            <form action="/add" method="POST" class="grid grid-cols-1 md:grid-cols-3 gap-4">
                <div>
                    <label class="block text-xs font-medium text-slate-400 mb-1">Discord ID (จำเป็น)</label>
                    <input type="text" name="discordId" required placeholder="เช่น 1559996775236898946" 
                           class="w-full bg-slate-900 border border-slate-700 rounded-lg px-4 py-2 text-white text-sm focus:outline-none focus:border-red-500">
                </div>
                <div>
                    <label class="block text-xs font-medium text-slate-400 mb-1">Game UID (ระบุหรือไม่ก็ได้)</label>
                    <input type="text" name="gameUid" placeholder="เช่น UID-10023" 
                           class="w-full bg-slate-900 border border-slate-700 rounded-lg px-4 py-2 text-white text-sm focus:outline-none focus:border-red-500">
                </div>
                <div class="flex items-end">
                    <button type="submit" class="w-full bg-red-600 hover:bg-red-500 text-white font-bold py-2 px-4 rounded-lg transition text-sm">
                        เพิ่ม Whitelist
                    </button>
                </div>
            </form>
        </div>

        <!-- Search Bar & Table Card -->
        <div class="bg-slate-800 rounded-xl border border-slate-700 overflow-hidden shadow-xl">
            <div class="p-4 border-b border-slate-700 flex justify-between items-center">
                <h2 class="text-lg font-bold text-slate-200">รายชื่อในระบบ</h2>
                <form action="/" method="GET" class="flex gap-2">
                    <input type="text" name="search" value="<%= search %>" placeholder="ค้นหา Discord ID / UID..." 
                           class="bg-slate-900 border border-slate-700 rounded-lg px-3 py-1.5 text-xs text-white focus:outline-none focus:border-red-500">
                    <button type="submit" class="bg-slate-700 hover:bg-slate-600 text-xs px-3 py-1.5 rounded-lg">ค้นหา</button>
                </form>
            </div>

            <div class="overflow-x-auto">
                <table class="w-full text-left border-collapse text-sm">
                    <thead>
                        <tr class="bg-slate-900/50 text-slate-400 border-b border-slate-700 text-xs">
                            <th class="p-4">#</th>
                            <th class="p-4">Discord ID</th>
                            <th class="p-4">Game UID</th>
                            <th class="p-4 text-right">การจัดการ</th>
                        </tr>
                    </thead>
                    <tbody class="divide-y divide-slate-700">
                        <% if (whitelist.length === 0) { %>
                            <tr>
                                <td colspan="4" class="p-6 text-center text-slate-500">ไม่พบข้อมูล Whitelist ในระบบ</td>
                            </tr>
                        <% } else { %>
                            <% whitelist.forEach((item, index) => { %>
                                <tr class="hover:bg-slate-700/30 transition">
                                    <td class="p-4 text-slate-500"><%= index + 1 %></td>
                                    <td class="p-4 font-mono font-medium text-slate-200"><%= item.DiscordId %></td>
                                    <td class="p-4 text-slate-400"><%= item.GameUid || '-' %></td>
                                    <td class="p-4 text-right">
                                        <form action="/delete/<%= item.Id %>" method="POST" onsubmit="return confirm('ยืนยันที่จะลบรายการนี้ใช่ไหม?');" class="inline">
                                            <button type="submit" class="bg-red-500/10 hover:bg-red-500 text-red-500 hover:text-white border border-red-500/20 px-3 py-1 rounded-md text-xs transition">
                                                ลบ
                                            </button>
                                        </form>
                                    </td>
                                </tr>
                            <% }); %>
                        <% } %>
                    </tbody>
                </table>
            </div>
        </div>
    </div>

</body>
</html>
